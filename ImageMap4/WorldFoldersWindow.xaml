<Window x:Class="ImageMap4.WorldFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageMap4"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="720"
        Height="520"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        FontSize="16">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="{Binding Description}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />
        <Border Grid.Row="1"
                BorderBrush="#FFABADB3"
                BorderThickness="1">
            <Grid>
                <ListView x:Name="FolderList"
                          ItemsSource="{Binding Items}"
                          BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Margin="0,4,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Path}"
                                               Foreground="Gray"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="No world folders were detected on this computer. Use Browse to add one manually."
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="15"
                           VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <DockPanel Grid.Row="2"
                   Margin="0,12,0,0">
            <Button DockPanel.Dock="Right"
                    Content="Select All"
                    Click="SelectAll_Click"
                    Padding="10,5,10,5"
                    ToolTip="Check every folder found on this computer" />
            <Button Content="Browse..."
                    Click="Browse_Click"
                    Padding="10,5,10,5"
                    HorizontalAlignment="Left" />
            <CheckBox Content="Replace current list"
                      IsChecked="{Binding ReplaceExisting, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Margin="15,0,0,0" />
        </DockPanel>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="OK"
                    Click="Ok_Click"
                    Padding="15,5,15,5"
                    IsDefault="True" />
            <Button Content="Cancel"
                    Padding="15,5,15,5"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
